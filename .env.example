# Copie para .env. Todas são opcionais para rodar localmente com Docker.

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-isto
DJANGO_ALLOWED_HOSTS=*

# Banco: DATABASE_URL tem prioridade (Postgres gerenciado, ex.: Neon na Vercel).
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Origens do frontend liberadas (separadas por vírgula) e, opcionalmente, um padrão para previews da Vercel
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGIN_REGEX=^https://cotador-.*\.vercel\.app$

# Extração: deterministico (padrão, sem custo) ou llm (exige chave)
EXTRATOR_PADRAO=deterministico
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Regras
LIMITE_VARIACAO_ALERTA=25
BANDA_ANS_PCT=30
TOLERANCIA_PADRAO_FAIXAS_PCT=1

# Demonstração
DEMO_PERMITE_REINICIAR=1
# ORIGINAIS_NO_BANCO=1   (ligado automaticamente na Vercel)
